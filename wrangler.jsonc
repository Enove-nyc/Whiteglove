// White Glove Itineraries on Cloudflare Workers, through OpenNext
// (@opennextjs/cloudflare). See open-next.config.ts and AGENTS.md.
//
// The storage below is created by Wrangler on the first deploy if it does not
// exist yet: uploaded files in the "whiteglove-media" R2 bucket (lib/media.ts,
// MEDIA_STORE=r2), Next's page cache in "whiteglove-cache", and the cache's
// revalidation tags in the "whiteglove-tag-cache" D1 database.
//
// keep_vars: the site's settings and secrets are set in the Cloudflare
// dashboard, and a deploy must never wipe them.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whiteglove",
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "MEDIA_STORE": "r2"
  },
  // Which deploy is running. The page cache in cloudflare-worker.ts keys on it,
  // so a new release never serves a page built by the old one.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "whiteglove"
    }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "whiteglove-media" },
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "whiteglove-cache" }
  ],
  "d1_databases": [
    { "binding": "NEXT_TAG_CACHE_D1", "database_name": "whiteglove-tag-cache" }
  ],
  // Followed flights are re-checked every 30 minutes (cloudflare-worker.ts).
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
