// White Glove — content database schema
// -------------------------------------------------------------------
// Target: Neon Postgres (free tier). Requires a DATABASE_URL env var
// pointing at the Neon connection string (add it in Vercel > Settings >
// Environment Variables, and to a local .env for `prisma migrate`).
//
// This schema models the destination/CMS content that today lives as
// hardcoded TypeScript in `data/*.ts` plus the admin content bundle in
// Redis. Accounts, sessions, analytics counters and the site lock stay
// on Upstash Redis — Redis is the right tool for those and they are NOT
// modeled here on purpose.
//
// Workflow after provisioning the DB:
//   npx prisma migrate dev --name init   # create tables
//   npx prisma db seed                    # import data/*.ts (see prisma/seed.ts)
// -------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL lives in prisma.config.ts (datasource.url),
// not here. The schema only declares the provider.
datasource db {
  provider = "postgresql"
}

// ---- Enums ----------------------------------------------------------

// Preserves where a destination came from so the right template renders.
enum DestinationKind {
  CITY_GUIDE // rich guide (data/city-guides.ts) — tzaddik, seforim, findings
  DESTINATION // compact entry (data/bulk-destinations.ts)
  SACRED_STOP // waypoint with address/coords (data/sacred-stops.ts)
}

// Editorial state, mirrors the admin content statuses.
enum ContentStatus {
  PUBLISHED
  DRAFT
  NEEDS_REVIEW
}

// A source package is held separately from public content until an editor has
// checked each listing. This prevents a large import from silently becoming a
// bulk publish.
enum ContentImportKind {
  ATTRACTION
  KOSHER_FOOD
  PLACE_TO_STAY
  PRACTICAL
}

enum ContentImportStatus {
  NEEDS_REVIEW
  DUPLICATE
  REJECTED
  PUBLISHED
}

// How confident we are in a piece of practical info (mirrors
// VerificationStatus in data/destination-database.ts).
enum VerificationStatus {
  VERIFIED
  UNAVAILABLE
  NEEDS_VERIFICATION
}

// One table serves every kind of on-the-ground listing. Covers the
// Milestone-1 expansion list (Hotel, KosherEstablishment, Minyan,
// Mikvah, Airport, Driver) without a table per type.
//
// The last six were added later. Four of them are the practical things
// lib/verification.ts has been counting as missing from every destination
// because there was nowhere to put them: tefillos, Shabbos arrangements,
// hospital, emergency services. GROCERY and PARKING come with them because an
// enum is a vocabulary — adding one value later costs another migration with
// the same care as this one, so the words that are plainly needed go in
// together.
//
// KOSHER_FOOD is somewhere you eat. GROCERY is somewhere you buy food to cook,
// which is the question a family in a rented flat is actually asking.
enum PlaceCategory {
  ACCOMMODATION
  KOSHER_FOOD
  MINYAN
  MIKVAH
  TRANSPORT
  AIRPORT
  DRIVER
  TEFILLOS // shul, beis medrash, davening times
  SHABBOS // eruv, hospitality, seudos, what closes and when
  HOSPITAL
  EMERGENCY // Hatzolah, chaverim, police, embassy
  GROCERY // kosher shops and bakeries
  PARKING
}

// ---- Core content ---------------------------------------------------

model Destination {
  id           String          @id @default(cuid())
  slug         String          @unique
  kind         DestinationKind @default(DESTINATION)
  city         String
  yiddishCity  String
  country      String
  aliases      String[]        @default([])
  overview     String? // long-form intro (city guides)
  summary      String? // short blurb (bulk destinations)
  safetyNote   String?
  sourceUrl    String?
  // Where the rest of it came from. `sourceUrl` holds the one original
  // source; a page assembled from a shomer's phone call, a seforim reference
  // and a council website has several, and a page nobody can trace is a page
  // nobody can re-check.
  sources      String[]        @default([])
  status       ContentStatus   @default(PUBLISHED)
  // How far this has been CHECKED, which is not the same question as whether
  // it is published. `status` is editorial — is it live. This is what decides
  // whether somebody drives four hours on the strength of the page, and it is
  // what lib/verification.ts turns into "Verified on 3 March 2026".
  verification VerificationStatus @default(NEEDS_VERIFICATION)
  notes        String[]        @default([])
  lastVerified DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tzaddikim  Tzaddik[]
  cemeteries Cemetery[]
  contacts   Contact[]
  places     PracticalPlace[]
  photos     Photo[]

  @@index([kind])
  @@index([country])
}

// A tzaddik, either the primary one featured on a city page
// (isPrimary) or one of several buried in a cemetery.
model Tzaddik {
  id               String             @id @default(cuid())
  name             String
  yiddishName      String
  knownAs          String?
  seforim          String?
  yahrzeit         String?
  niftar           String? // year of petirah, kept as text (e.g. "תקמ\"ז")
  graveAddress     String?
  graveCoordinates String?
  findingNotes     String[]           @default([])
  note             String?
  isPrimary        Boolean            @default(false)
  status           VerificationStatus @default(NEEDS_VERIFICATION)
  source           String?

  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  destinationId String?
  cemetery      Cemetery?    @relation(fields: [cemeteryId], references: [id], onDelete: SetNull)
  cemeteryId    String?

  @@index([destinationId])
  @@index([cemeteryId])
}

model Cemetery {
  id           String             @id @default(cuid())
  slug         String             @unique
  city         String
  yiddishCity  String
  name         String
  yiddishName  String
  country      String
  address      String?
  coordinates  String?
  arrivalNotes String[]           @default([])
  accessNote   String?
  status       VerificationStatus @default(NEEDS_VERIFICATION)
  sourceUrl    String?
  // When somebody last checked. "Verified" with no date is a claim with no
  // age, and an access note from four years ago is not the same fact as one
  // from last month.
  lastVerified DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  destinationId String?
  burials       Tzaddik[]
  contacts      Contact[]
  photos        Photo[]

  @@index([destinationId])
}

// Shomer / access contact. Attaches to a destination or a cemetery.
model Contact {
  id     String             @id @default(cuid())
  label  String
  phone  String?
  email  String?
  note   String?
  source String?
  status VerificationStatus @default(NEEDS_VERIFICATION)
  /**
   * The day somebody last confirmed this contact still answers.
   *
   * A phone number is the most perishable thing on the site — the record can
   * look complete for years after the number stopped working. Stamped whenever
   * the contact is saved in the admin, so a date means somebody looked at it
   * on that day rather than that somebody typed a date in. Null means nobody
   * has, and the public side says nothing rather than guessing.
   */
  lastVerified DateTime?

  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  destinationId String?
  cemetery      Cemetery?    @relation(fields: [cemeteryId], references: [id], onDelete: Cascade)
  cemeteryId    String?

  @@index([destinationId])
  @@index([cemeteryId])
}

// Lodging, kosher food, minyanim, mikvaos, transport, airports, drivers.
// Mirrors EditableAccommodation from lib/admin-content.ts, generalized.
model PracticalPlace {
  id           String        @id @default(cuid())
  category     PlaceCategory
  name         String
  yiddishName  String?
  address      String?
  phone        String?
  whatsapp     String?
  email        String?
  website      String?
  bookingLink  String?
  coordinates  String?
  hours        String? // opening times / minyan schedule / mikvah hours
  amenities    String?
  kosherInfo   String?
  notes        String?
  status       ContentStatus @default(DRAFT)
  // Per-listing, because a page's sections are checked separately and at
  // different times. destinationTrust() is deliberately pessimistic — one
  // checked section out of five reads as "partially verified" — and it can
  // only be that honest if each listing carries its own answer.
  verification VerificationStatus @default(NEEDS_VERIFICATION)
  sourceUrl    String?
  lastVerified DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  destinationId String
  photos        Photo[]

  @@index([destinationId, category])
}

// ---- The rest of the trip ---------------------------------------------
//
// Attractions, kosher stays and the Jewish quarters they are measured from.
// These start life in data/attractions.ts and data/kosher-stays.ts, are loaded
// into these tables by the seed, and are read back through
// lib/attractions-view.ts — which is what every search on the site goes
// through. The point of the tables is that an entry the owner adds in the
// admin lands in exactly the same place as one that ships in the data files,
// so it is searchable everywhere the built-in ones are.
//
// Unlike a kever, a coordinate here is a public landmark and is safe to
// navigate to. Hours and prices are deliberately not stored — they go stale.

// Something to do: a museum, a mountain, a castle, a Jewish-heritage site.
model Attraction {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  city        String
  country     String
  kind        String // "Museum" | "Nature" | "Landmark" | …
  summary     String
  address     String?
  coordinates String? // "lat, lng" — a real, navigable location
  website     String?
  notes       String[]      @default([])
  shabbos     String? // what it does on Shabbos and yom tov
  sourceUrl   String
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([country, city])
}

// Somewhere to sleep, measured from the shul or quarter it is near.
model KosherStay {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  city         String
  country      String
  kind         String // "Kosher hotel" | "Ordinary hotel, well placed" | …
  summary      String
  anchorName   String // the shul/quarter distances are measured from
  anchorCoords String // the ANCHOR's coordinates, never a guessed hotel pin
  season       String? // set only for a seasonal programme
  kosherClaim  String        @default("none") // none | reported | confirmed
  notes        String[]      @default([])
  website      String?
  sourceUrl    String
  status       ContentStatus @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([country, city])
}

// A Jewish quarter — the answer to "which part of town do I stay in".
model KosherArea {
  id          String        @id @default(cuid())
  slug        String        @unique
  city        String
  country     String
  name        String
  coordinates String
  note        String
  sourceUrl   String
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([country, city])
}

// A documented source package. The source and licence live on the batch as
// well as on every candidate, so an editor can still trace a row after it is
// copied into public content or its source package is refreshed.
model ContentImportBatch {
  id          String                   @id @default(cuid())
  slug        String                   @unique
  name        String
  sourceName  String
  sourceUrl   String
  attribution String
  license     String?
  isBuiltIn   Boolean                  @default(false)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  candidates ContentImportCandidate[]

  @@index([createdAt])
}

// A private, source-backed candidate. This is intentionally not related
// directly to the public tables: a row can become an Attraction, KosherStay or
// PracticalPlace only after the review action validates the target's stricter
// requirements. `publishedId` and `publishedKind` leave an audit trail without
// pretending those three models share an id space.
model ContentImportCandidate {
  id                 String              @id @default(cuid())
  kind               ContentImportKind
  category           String?
  name               String
  aliases            String[]            @default([])
  city               String
  region             String?
  country            String
  destinationSlug    String?
  address            String?
  coordinates        String?
  website            String?
  summary            String?
  anchorName         String?
  anchorCoords       String?
  kosherClaim        String              @default("none")
  kosherSourceUrl    String?
  sourceUrl          String
  sourceId           String
  sourceName         String
  attribution        String
  license            String?
  sourceEvidence     Json?
  normalizedName     String
  normalizedLocation String
  dedupeKey          String              @unique
  status             ContentImportStatus @default(NEEDS_REVIEW)
  validationErrors   String[]            @default([])
  duplicateOf        String?
  publishedKind      String?
  publishedId        String?
  reviewedAt         DateTime?
  publishedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  batch   ContentImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId String

  @@index([batchId, status])
  @@index([kind, status])
  @@index([country, city])
}

// Non-secret Trello scope for private bulk-candidate review. API credentials
// remain server environment variables; no public content is related to this
// setting or created by changing a card's Trello status.
model TrelloCandidateReviewSettings {
  id           String   @id
  boardId      String
  reviewListId String
  doneListId   String
  enabled      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Stable source candidate ID -> Trello card ID mapping. It has no foreign key
// to ContentImportCandidate because source packages can be reviewed before
// DATABASE_URL is configured and staging creates a separate transient row ID.
model TrelloCandidateReviewCard {
  id           String   @id @default(cuid())
  candidateId  String   @unique
  boardId      String
  reviewListId String
  status       String   @default("CREATING")
  trelloCardId String?  @unique
  cardUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([boardId, reviewListId])
}

// A picture of a place, with where it came from.
//
// "Photos" is one of the five things lib/verification.ts counts as missing
// from every destination because the schema had nowhere to put one.
//
// CREDIT AND SOURCE ARE NOT DECORATION. A photograph belongs to whoever took
// it, and the site cannot publish one on the strength of having found it. A
// row with no credit is a row nobody can defend, which is why the admin will
// treat a missing credit as reason not to publish rather than a blank field.
//
// Draft by default. A picture appearing on a public page the moment it is
// uploaded is the wrong way round for photographs of kevarim in particular.
//
// This is the table, not the media library — that is scan 2 §7, and it can be
// built on this without another migration.
model Photo {
  id        String        @id @default(cuid())
  url       String
  caption   String?
  /** Who took it, or who it belongs to. */
  credit    String?
  /** Where it was obtained, so the permission can be traced back. */
  sourceUrl String?
  status    ContentStatus @default(DRAFT)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  destination   Destination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  destinationId String?
  cemetery      Cemetery?    @relation(fields: [cemeteryId], references: [id], onDelete: Cascade)
  cemeteryId    String?
  /**
   * A picture of one listing — a hotel room, the front of a shul, the door of
   * a mikvah. A town-level photo says what the place looks like; this says
   * what THIS one looks like, which is the question somebody deciding between
   * two hotels is actually asking.
   */
  place         PracticalPlace? @relation(fields: [placeId], references: [id], onDelete: Cascade)
  placeId       String?

  /**
   * Sent in by a visitor, and when.
   *
   * Null on anything the owner uploaded. It is the marker that separates a
   * stranger's picture from the owner's own draft — without it the two look
   * identical in the admin, and the difference matters: publishing your own
   * unfinished picture is a decision, publishing a stranger's is a liability.
   */
  submittedAt    DateTime?
  submittedBy    String?
  submittedEmail String?
  submitterNote  String?

  @@index([destinationId])
  @@index([cemeteryId])
  @@index([placeId])
  @@index([submittedAt])
}

// ---- CMS operational tables (migrated from the Redis content bundle) --

// Visitor-submitted correction (SuggestEditButton -> admin review).
model EditSuggestion {
  id            String    @id @default(cuid())
  targetType    String // "location" | "accommodation" | "site"
  targetId      String
  title         String
  name          String
  email         String
  issue         String
  currentInfo   String    @default("")
  suggestedInfo String    @default("")
  source        String?
  status        String    @default("pending") // pending|approved|rejected|needs-info
  reviewerNotes String?
  createdAt     DateTime  @default(now())
  reviewedAt    DateTime?

  @@index([status])
}

// Sponsored banners — already the one admin->public bridge that works.
model Promotion {
  id                 String    @id @default(cuid())
  title              String
  description        String    @default("")
  buttonText         String    @default("")
  targetHref         String    @default("")
  imageUrl           String?
  pdfUrl             String?
  placements         String[]  @default([])
  targetPaths        String    @default("")
  device             String    @default("all") // all|mobile|desktop
  startDate          DateTime?
  endDate            DateTime?
  priority           Int       @default(0)
  maxViewsPerVisitor Int       @default(0)
  enabled            Boolean   @default(true)
  impressions        Int       @default(0)
  clicks             Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastShownAt        DateTime?
  lastClickedAt      DateTime?

  @@index([enabled, priority])
}

// Global site settings — one row, id fixed to "site".
model SiteSetting {
  id                String   @id @default("site")
  heroTitle         String
  heroSubtitle      String
  searchPlaceholder String
  publicNotice      String
  footerEmail       String
  bookingNotice     String
  updatedAt         DateTime @updatedAt
}

// Directory of service providers (tour operators, vacation planners, travel
// agencies, guides & drivers) that travelers can look up. Distinct from the
// per-destination PracticalPlace listings — these are businesses/people, not
// on-the-ground spots tied to one city.
enum ProviderCategory {
  TOUR_OPERATOR // organized trips & kever tours
  VACATION_PLANNER // full-trip planners / concierges
  TRAVEL_AGENCY // flights, hotels, packages
  GUIDE_DRIVER // tour guides & private drivers
}

model DirectoryProvider {
  id          String           @id @default(cuid())
  slug        String           @unique
  name        String
  category    ProviderCategory
  tagline     String?
  description String?
  phone       String?
  whatsapp    String?
  email       String?
  website     String?
  basedIn     String?
  regions     String[]         @default([]) // countries/areas served
  languages   String[]         @default([])
  specialties String[]         @default([])
  featured    Boolean          @default(false)
  /**
   * Why it is featured — "service" or "sponsored". Owner's record only: the
   * badge is the same either way and a visitor is not told which. The
   * directory's disclosure says some featured listings are sponsored, without
   * naming them. Empty means nobody has said, which is worth being able to see.
   */
  featuredReason String        @default("")
  status      ContentStatus    @default(PUBLISHED)
  source      String?

  // Whether this listing has actually been checked, and when. A directory of
  // people offering to take your family abroad is exactly the place where an
  // unchecked entry does harm, so absent means unverified rather than fine.
  verification VerificationStatus @default(NEEDS_VERIFICATION)
  verifiedAt   DateTime?

  // CONSENT TO PUBLISH A PERSONAL NUMBER.
  //
  // Many of these are one person with a mobile, not a business with a
  // switchboard, and putting somebody's own number on a public page is not
  // something to infer from them having given it to us once. Default false,
  // deliberately: the flag has to be set by somebody who asked. Absent
  // consent the number is held but not shown.
  //
  // `contactConsentNote` records how it was given — "asked by phone, 4 March"
  // — so the answer to "who said we could" is not somebody's memory.
  contactConsent     Boolean   @default(false)
  contactConsentAt   DateTime?
  contactConsentNote String?

  // Roughly how quickly they answer, in the owner's words ("same day",
  // "within a week"). Free text rather than hours: a number implies a
  // measurement nobody is taking, and a promise the site cannot keep.
  responseTime String?

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([category])
}

// Generic editable marketing/info page (Milestone-1 "Page").
model Page {
  id        String        @id @default(cuid())
  slug      String        @unique
  title     String
  body      String        @default("")
  // The page rebuilt as a list of blocks, once the owner has edited it here.
  // Nullable and additive: null means "never edited", and the page renders from
  // its built-in version in code. See docs/pages-migration.md.
  blocks    Json?
  // What a search engine shows. Empty falls back to the page's own heading.
  seoTitle       String   @default("")
  seoDescription String   @default("")
  status    ContentStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}
